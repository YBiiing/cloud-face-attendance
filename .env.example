# Copy to .env; generate your own secrets. Do not commit .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_SECRET=
MYSQL_HOST_PORT=3307
API_HOST_PORT=8000
# Provisional defaults; calibrate with consented local samples before acceptance.
MATCH_THRESHOLD=0.5
MATCH_MARGIN=0.05
# Shared campus NAT budget; per-session budget is max(60, roster size * attempts).
CHECKIN_IP_RATE_LIMIT=600
CHECKIN_ATTEMPTS_PER_STUDENT=3
